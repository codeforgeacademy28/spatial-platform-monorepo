# App Configuration
NODE_ENV=development
PORT=4000

# API Gateway Endpoint
VITE_API_URL=http://localhost:4000

# Phone-controller WebSocket endpoint. Use wss:// for a deployed HTTPS app.
VITE_CONTROLLER_WS_URL=wss://controller-game-13dk.onrender.com

# Supabase Configuration (Free Tier)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 Object Storage (3D Assets & Floor Plans)
CLOUDFLARE_R2_ACCOUNT_ID=your-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-key
CLOUDFLARE_R2_BUCKET_NAME=spatial-platform-assets

# AI Services Configuration
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key
